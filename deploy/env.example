# /etc/cyber-favorites/env —— systemd 服务读的配置
# 设置了 CF_PUBLIC_URL 就是服务器模式：所有访问都要登录，抓取网页时屏蔽内网地址
CF_PUBLIC_URL=https://fav.example.com
CF_PORT=4170
CF_HOST=127.0.0.1
CF_DATA=/var/lib/cyber-favorites/data.json
# 单个上传文件的上限（MB），要和 nginx 的 client_max_body_size 对得上
CF_MAX_UPLOAD_MB=50
# 可选：抓取 GitHub 仓库信息用，不设的话 GitHub 每小时只给 60 次
# GITHUB_TOKEN=
