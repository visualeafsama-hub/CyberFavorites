# systemd 服务。用法见 README 的“部署到服务器”。
# 程序放在 /srv/cyber-favorites，数据在 /var/lib/cyber-favorites，配置在 /etc/cyber-favorites/env。
[Unit]
Description=CyberFavorites 赛博收藏夹
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cyberfav
Group=cyberfav
WorkingDirectory=/srv/cyber-favorites
EnvironmentFile=/etc/cyber-favorites/env
ExecStart=/usr/local/bin/node /srv/cyber-favorites/server.js
Restart=on-failure
RestartSec=3

# 只能写自己的数据目录，其他地方都是只读
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/cyber-favorites
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
